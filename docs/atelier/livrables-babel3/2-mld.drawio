<mxfile host="app.diagrams.net"><diagram name="2-mld" id="2-mld"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b_rec" value="&lt;div style=&quot;text-align:center;background:#1f4e79;color:#fff;font-size:15px;font-weight:bold;padding:5px;margin:-2px -8px 4px -8px&quot;&gt;RECHERCHE&lt;/div&gt;&lt;b&gt;# id&lt;/b&gt;&lt;br&gt;utilisateur_id (→ UTILISATEUR, peut être vide)&lt;br&gt;texte&lt;br&gt;créée_le" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;strokeColor=#1f4e79;strokeWidth=2;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="80" width="360" height="142" as="geometry"/></mxCell><mxCell id="b_u" value="&lt;div style=&quot;text-align:center;background:#1f4e79;color:#fff;font-size:15px;font-weight:bold;padding:5px;margin:-2px -8px 4px -8px&quot;&gt;UTILISATEUR&lt;/div&gt;&lt;b&gt;# id&lt;/b&gt;&lt;br&gt;nom&lt;br&gt;email (unique)&lt;br&gt;mot_de_passe_hash&lt;br&gt;rôle (membre | admin)&lt;br&gt;suspendu&lt;br&gt;créé_le" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;strokeColor=#1f4e79;strokeWidth=2;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="80" width="360" height="208" as="geometry"/></mxCell><mxCell id="b_a" value="&lt;div style=&quot;text-align:center;background:#1f4e79;color:#fff;font-size:15px;font-weight:bold;padding:5px;margin:-2px -8px 4px -8px&quot;&gt;ADRESSE&lt;/div&gt;&lt;b&gt;# id&lt;/b&gt;&lt;br&gt;empreinte (unique, taille fixe)&lt;br&gt;hexagone (texte long)&lt;br&gt;mur&lt;br&gt;étagère&lt;br&gt;volume&lt;br&gt;page" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;strokeColor=#1f4e79;strokeWidth=2;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="930" y="80" width="360" height="208" as="geometry"/></mxCell><mxCell id="b_note" value="&lt;b&gt;Choix de conception&lt;/b&gt;&lt;br&gt;Aucune page n&amp;#x27;est stockée : seule l&amp;#x27;adresse l&amp;#x27;est.&lt;br&gt;La clé secrète n&amp;#x27;est pas en base (configuration).&lt;br&gt;Une adresse n&amp;#x27;existe en base que si elle est citée&lt;br&gt;(favori, signalement, masquage).&lt;br&gt;L&amp;#x27;empreinte identifie les adresses de 3 000+ car.&lt;br&gt;# = identifiant   → = clé étrangère" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff8dc;strokeColor=#b8a04a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1370" y="80" width="360" height="190" as="geometry"/></mxCell><mxCell id="b_res" value="&lt;div style=&quot;text-align:center;background:#1f4e79;color:#fff;font-size:15px;font-weight:bold;padding:5px;margin:-2px -8px 4px -8px&quot;&gt;RESULTAT_RECHERCHE&lt;/div&gt;&lt;b&gt;# id&lt;/b&gt;&lt;br&gt;recherche_id (→ RECHERCHE)&lt;br&gt;bibliotheque_id (→ BIBLIOTHEQUE, vide = locale)&lt;br&gt;statut (ok|expirée|invalide|injoignable)&lt;br&gt;adresse_trouvée (texte reçu)&lt;br&gt;durée_ms" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;strokeColor=#1f4e79;strokeWidth=2;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="380" width="360" height="186" as="geometry"/></mxCell><mxCell id="b_fav" value="&lt;div style=&quot;text-align:center;background:#1f4e79;color:#fff;font-size:15px;font-weight:bold;padding:5px;margin:-2px -8px 4px -8px&quot;&gt;FAVORI&lt;/div&gt;&lt;b&gt;# utilisateur_id (→ UTILISATEUR)&lt;/b&gt;&lt;br&gt;&lt;b&gt;# adresse_id (→ ADRESSE)&lt;/b&gt;&lt;br&gt;note&lt;br&gt;ajouté_le" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;strokeColor=#1f4e79;strokeWidth=2;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="380" width="360" height="142" as="geometry"/></mxCell><mxCell id="b_sig" v