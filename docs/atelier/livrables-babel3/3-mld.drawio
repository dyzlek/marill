tSize=34;fontStyle=1;fontSize=16;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;strokeWidth=2;swimlaneFillColor=#ffffff;collapsible=0;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="710" y="956" width="360" height="158" as="geometry"/></mxCell><mxCell id="com_b" value="&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;#utilisateur_id (vide si compte supprime)&lt;br&gt;#adresse_id&lt;br&gt;texte&lt;br&gt;cree_le" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=15;whiteSpace=wrap;" vertex="1" parent="com"><mxGeometry y="34" width="360" height="124" as="geometry"/></mxCell><mxCell id="sig" value="SIGNALEMENT" style="swimlane;html=1;startSize=34;fontStyle=1;fontSize=16;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;strokeWidth=2;swimlaneFillColor=#ffffff;collapsible=0;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="710" y="1174" width="360" height="202" as="geometry"/></mxCell><mxCell id="sig_b" value="&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;#utilisateur_id (vide si visiteur)&lt;br&gt;#adresse_id&lt;br&gt;motif&lt;br&gt;statut (en_attente | accepte | rejete)&lt;br&gt;cree_le&lt;br&gt;traite_le (vide si en attente)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=15;whiteSpace=wrap;" vertex="1" parent="sig"><mxGeometry y="34" width="360" height="168" as="geometry"/></mxCell><mxCell id="cons" value="CONSULTATION" style="swimlane;html=1;startSize=34;fontStyle=1;fontSize=16;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;strokeWidth=2;swimlaneFillColor=#ffffff;collapsible=0;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="710" y="1436" width="360" height="136" as="geometry"/></mxCell><mxCell id="cons_b" value="&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;#utilisateur_id (vide si visiteur)&lt;br&gt;#adresse_id&lt;br&gt;cree_le" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=15;whiteSpace=wrap;" vertex="1" parent="cons"><mxGeometry y="34" width="360" height="102" as="geometry"/></mxCell><mxCell id="u" value="UTILISATEUR" style="swimlane;html=1;startSize=34;fontStyle=1;fontSize=16;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;strokeWidth=2;swimlaneFillColor=#ffffff;collapsible=0;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="120" y="586" width="360" height="986" as="geometry"/></mxCell><mxCell id="u_b" value="&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;nom&lt;br&gt;email (unique)&lt;br&gt;mot_de_passe_hash&lt;br&gt;role (membre | admin)&lt;br&gt;suspendu&lt;br&gt;derniere_connexion_le&lt;br&gt;cree_le" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=15;whiteSpace=wrap;" vertex="1" parent="u"><mxGeometry y="34" width="360" height="952" as="geometry"/></mxCell><mxCell id="a" value="ADRESSE" style="swimlane;html=1;startSize=34;fontStyle=1;fontSize=16;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;strokeWidth=2;swimlaneFillColor=#ffffff;collapsible=0;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1300" y="586" width="360" height="986" as="geometry"/></mxCell><mxCell id="a_b" value="&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;#bibliotheque_id&lt;br&gt;empreinte (taille fixe)&lt;br&gt;hexagone (texte long)&lt;br&gt;mur&lt;br&gt;etagere&lt;br&gt;volume&lt;br&gt;page&lt;br&gt;masquee (oui | non)&lt;br&gt;masquee_le&lt;br&gt;&lt;i&gt;unique (bibliotheque_id, empreinte)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=15;whiteSpace=wrap;" vertex="1" parent="a"><mxGeometry y="34" width="360" height="952" as="geometry"/></mxCell><mxCell id="bib" value="BIBLIOTHEQUE" style="swimlane;html=1;startSize=34;fontStyle=1;fontSize=16;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;strokeWidth=2;swimlaneFillColor=#ffffff;collapsible=0;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1890" y="586" width="360" height="224" as="geometry"/></mxCell><mxCell id="bib_b" value="&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;identifiant_reseau (unique, stable)&lt;br&gt;nom&lt;br&gt;url_base (peut changer)&lt;br&gt;est_locale (oui sur une seule ligne)&lt;br&gt;autorisee (oui | non)&lt;br&gt;empreinte_jeton_api&lt;br&gt;derniere_reponse_le" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=15;whiteSpace=wrap;" vertex="1" parent="bib"><mxGeometry y="34" width="360" height="190" as="geometry"/></mxCell><mxCell id="reg" value="REGLAGE" style="swimlane;html=1;startSize=34;fontStyle=1;fontSize=16;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;strokeWidth=2;swimlaneFillColor=#ffffff;collapsible=0;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1890" y="930" width="360" height="136" as="geometry"/></mxCell><mxCell id="reg_b" value="&lt;u&gt;&lt;b&gt;cle&lt;/b&gt;&lt;/u&gt;&lt;br&gt;valeur&lt;br&gt;(description, inscriptions&lt;br&gt;ouvertes...)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=15;whiteSpace=wrap;" vertex="1" parent="reg"><mxGeometry y="34" width="360" height="102" as="geometry"/></mxCell><mxCell id="titre" value="MLD : La Bibliothèque de Babel en réseau (groupe Babel 3)" style="text;html=1;fontSize=28;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="20" width="1200" height="44" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Choix de conception&lt;/b&gt;&lt;br&gt;• On ne stocke jamais le texte d&#x27;une page, seulement son adresse : le moteur le recalcule à chaque lecture. La clé secrète du moteur n&#x27;est pas en base (configuration du serveur).&lt;br&gt;• Notre bibliothèque est la seule ligne de BIBLIOTHEQUE avec est_locale = oui (son nom est BIBLIOTHEQUE.nom, pas dans REGLAGE) : toute ADRESSE a donc une bibliothèque, et l&#x27;empreinte est unique par bibliothèque (pas de NULL).&lt;br&gt;• Page d&#x27;une autre bibliothèque : on la désigne par l&#x27;id de la bibliothèque, pas par son URL. Si l&#x27;URL change, on la modifie à un seul endroit.&lt;br&gt;• Une adresse entre dans la base quand quelqu&#x27;un la consulte ou la cite. CONSULTATION et derniere_connexion_le alimentent les statistiques de l&#x27;admin.&lt;br&gt;• Lien court : exactement une cible (page ou collection). Visiteur reconnu par jeton_visiteur (cookie) : 16 liens actifs max, le plus ancien (cree_le) est désactivé.&lt;br&gt;• Masquage : décidé par l&#x27;admin, porté par ADRESSE.masquee. Le signalement garde seulement son traitement (accepte | rejete).&lt;br&gt;• Suppression d&#x27;un compte : marque-pages, votes, collections et liens courts du compte supprimés (cascade) ; commentaires, signalements et consultations anonymisés (utilisateur_id vide).&lt;br&gt;• Suppression d&#x27;une collection : ses liens courts sont supprimés avec elle.&lt;br&gt;• Noms de tables et de champs sans accents (compatibles Laravel).&lt;br&gt;&lt;br&gt;&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt; clé primaire &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;#&lt;/b&gt;champ clé étrangère &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&#x27;#c00000&#x27;&gt;&lt;b&gt;0,n&lt;/b&gt;&lt;/font&gt; cardinalité" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#fff8dc;strokeColor=#b8860b;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="1662" width="2130" height="350" as="geometry"/></mxCell><mxCell id="e0" value="garde" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#555555;fontSize=14;fontStyle=2;labelBackgroundColor=#ffffff;edgeStyle=none;jumpStyle=arc;jumpSize=12;exitX=1;exitY=0.0578;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u" target="mp"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e0c0" value="0,n" style="edgeLabel;html=1;fontSize=15;fontStyle=1;fontColor=#c00000;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e0"><mxGeometry 