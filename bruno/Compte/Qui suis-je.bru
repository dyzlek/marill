meta {
  name: Qui suis-je
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/user
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jeton}}
}

headers {
  Accept: application/json
}

tests {
  test("200 avec le compte, sans mot de passe", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.email).to.equal("test@example.com");
    expect(res.getBody().data).to.not.have.property("password");
  });
}

docs {
  M1 : le compte connecté. Lancer « Créer un jeton » avant. 401 sans jeton.
}
