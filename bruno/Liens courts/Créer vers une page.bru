meta {
  name: Créer vers une page
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/liens-courts
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "adresse": "0-w1-s1-v1:1",
    "passage": "la bibliotheque"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("slug", res.getBody().data.slug);
  }
}

tests {
  test("201 : visiteur, sans auteur, expire", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.type).to.equal("page");
    expect(res.getBody().data.slug).to.match(/^[a-km-np-z2-9]{8}$/);
    expect(res.getBody().data.expire_le).to.be.a("string");
  });
}
