meta {
  name: Ouvrir
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/liens-courts/{{slug}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("200 : la page à ouvrir et le passage à surligner, une visite de plus", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.ouvrir).to.equal("0-w1-s1-v1:1");
    expect(res.getBody().data.passage).to.equal("la bibliotheque");
    expect(res.getBody().data.visites).to.be.above(0);
  });
}
