meta {
  name: Créer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/collections
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jeton}}
}

headers {
  Accept: application/json
}

body:json {
  {
    "nom": "Parcours Bruno",
    "description": "Créée depuis Bruno"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("collectionId", res.getBody().data.id);
  }
}

tests {
  test("201, vide et privée par défaut", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.est_publique).to.equal(false);
    expect(res.getBody().data.pages).to.eql([]);
  });
}
