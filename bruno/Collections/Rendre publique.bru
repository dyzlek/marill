meta {
  name: Rendre publique
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/collections/{{collectionId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jeton}}
}

headers {
  Accept: application/json
}

body:json {
  {
    "est_publique": true
  }
}

tests {
  test("200, publique (M5)", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.est_publique).to.equal(true);
  });
}
