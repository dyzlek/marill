meta {
  name: Ranger les pages
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/collections/{{collectionId}}/pages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jeton}}
}

headers {
  Accept: application/json
}

body:json {
  {
    "pages": [
      { "adresse": "1a-w2-s3-v4:5" },
      { "adresse": "0-w1-s1-v1:1" },
      { "adresse": "1a-w2-s3-v4:5" }
    ]
  }
}

tests {
  test("200, ordre conservé, une page peut revenir deux fois (règle 8)", function () {
    expect(res.getStatus()).to.equal(200);
    const pages = res.getBody().data.pages;
    expect(pages.map(p => p.position)).to.eql([1, 2, 3]);
    expect(pages.map(p => p.page.adresse)).to.eql(["1a-w2-s3-v4:5", "0-w1-s1-v1:1", "1a-w2-s3-v4:5"]);
  });
}
