meta {
  name: Ajouter une page
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/collections/{{collectionId}}/pages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jeton}}
}

headers {
  Accept: application/json
}

body:json {
  {
    "adresse": "0-w1-s1-v1:1"
  }
}

tests {
  test("200, la page arrive à la fin", function () {
    expect(res.getStatus()).to.equal(200);
    const pages = res.getBody().data.pages;
    expect(pages[pages.length - 1].page.adresse).to.equal("0-w1-s1-v1:1");
  });
}
