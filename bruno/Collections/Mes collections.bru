meta {
  name: Mes collections
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/collections
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jeton}}
}

headers {
  Accept: application/json
}

tests {
  test("200 avec le nombre de pages", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data[0]).to.have.property("nombre_pages");
  });
}
