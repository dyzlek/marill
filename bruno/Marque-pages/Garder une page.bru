meta {
  name: Garder une page
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/marque-pages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jeton}}
}

headers {
  Accept: application/json
}

body:json {
  {
    "adresse": "0-w1-s1-v1:{{numeroDePage}}",
    "titre": "Trouvée avec Bruno"
  }
}

script:pre-request {
  // Une page au hasard du premier volume, pour pouvoir relancer la requête sans tomber sur un doublon.
  bru.setVar("numeroDePage", Math.floor(Math.random() * 410) + 1);
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("marquePageId", res.getBody().data.id);
  }
}

tests {
  test("201 avec la page et sa bibliothèque", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.titre).to.equal("Trouvée avec Bruno");
    expect(res.getBody().data.page.locale).to.equal(true);
  });
}
