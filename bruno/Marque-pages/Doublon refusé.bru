meta {
  name: Doublon refusé
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/marque-pages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jeton}}
}

headers {
  Accept: application/json
}

body:json {
  {
    "adresse": "0-w1-s1-v1:{{numeroDePage}}"
  }
}

tests {
  test("409 : la même page n'est gardée qu'une fois (règle 7)", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().erreurs[0].code).to.equal("ERR_ALREADY_BOOKMARKED");
  });
}
