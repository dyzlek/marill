meta {
  name: Annoter
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/annotations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jeton}}
}

headers {
  Accept: application/json
}

body:json {
  {
    "adresse": "0-w1-s1-v1:1",
    "contenu": "Annotée depuis Bruno",
    "est_publique": true
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("annotationId", res.getBody().data.id);
  }
}

tests {
  test("201, publique", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.est_publique).to.equal(true);
  });
}
