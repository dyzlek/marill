meta {
  name: Annotations publiques d'une page
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/pages/0-w1-s1-v1:1/annotations
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("200 sans compte, avec le pseudo de l'auteur (V14)", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data[0]).to.have.property("auteur");
    expect(res.getBody().data[0]).to.not.have.property("email");
  });
}
