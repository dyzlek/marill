meta {
  name: Trop longue
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/annotations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jeton}}
}

headers {
  Accept: application/json
}

body:json {
  {
    "adresse": "0-w1-s1-v1:1",
    "contenu": "{{tropLong}}",
    "est_publique": false
  }
}

script:pre-request {
  bru.setVar("tropLong", "a".repeat(2001));
}

tests {
  test("422 au-delà de 2 000 caractères (règle 9)", function () {
    expect(res.getStatus()).to.equal(422);
  });
}
