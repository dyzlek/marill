meta {
  name: Lire une page
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/pages/0-w1-s1-v1:1
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("200 avec l'adresse et 3 200 caractères", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.adresse).to.equal("0-w1-s1-v1:1");
    expect(res.getBody().data.texte.length).to.equal(3200);
  });
}

docs {
  V1 · B1 : lire une page par son adresse. Route publique, sans jeton.
}
